APP_NAME="SaaS App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------
# Ports  ← change these if defaults clash locally
# -----------------------------------------------
APP_PORT=8000
KEYCLOAK_PORT=8080

# Derived URLs — keep in sync with the ports above.
APP_URL=http://localhost:8000

# -----------------------------------------------
# Database (Laravel App)
# -----------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres-app
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret

# -----------------------------------------------
# Session & Cache
# -----------------------------------------------
BROADCAST_CONNECTION=log
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

# -----------------------------------------------
# Keycloak OIDC Configuration
# -----------------------------------------------
# Browser-facing URL — must match KEYCLOAK_PORT above.
KEYCLOAK_BASE_URL=http://localhost:8080
# Container-to-container URL — always uses the Docker service name; port inside the container is always 8080.
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=saas-app
KEYCLOAK_CLIENT_ID=laravel-app
KEYCLOAK_CLIENT_SECRET=change-me-in-production-use-strong-secret
# Must match APP_PORT above.
KEYCLOAK_REDIRECT_URI=http://localhost:8000/auth/callback

# Admin credentials for Keycloak UI
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# -----------------------------------------------
# Keycloak Postgres (separate DB)
# -----------------------------------------------
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=keycloak
